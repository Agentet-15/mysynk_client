
import 'package:flutter/material.dart';

import 'mysynk_api.dart';
import 'server_config.dart';

class FilesPage extends StatefulWidget {
  const FilesPage({super.key});

  @override
  State<FilesPage> createState() => _FilesPageState();
}

class _FilesPageState extends State<FilesPage> {
  MySynkApi? _api;

  List<Map<String, dynamic>> _items = [];
  bool _loading = true;
  String? _error;

  String _currentPath = '/';
  bool _gridView = false;

  @override
  void initState() {
    super.initState();
    _loadFiles();
  }

  Future<void> _loadFiles() async {
    setState(() {
      _loading = true;
      _error = null;
    });

    try {
      final serverUrl = await ServerConfig.getServerUrl();

      _api = MySynkApi(
        baseUrl: serverUrl,
      );

      final items = await _api!.listFiles(_currentPath);

      if (!mounted) {
        return;
      }

      setState(() {
        _items = items;
        _loading = false;
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _loading = false;
        _error = 'No se pudieron cargar los archivos.';
      });
    }
  }

  Future<void> _openFolder(String path) async {
    setState(() {
      _currentPath = path;
      _loading = true;
      _error = null;
    });

    try {
      final items = await _api!.listFiles(path);

      if (!mounted) {
        return;
      }

      setState(() {
        _items = items;
        _loading = false;
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _loading = false;
        _error = 'No se pudo abrir la carpeta.';
      });
    }
  }

  void _goBack() {
    if (_currentPath == '/') {
      Navigator.of(context).pop();
      return;
    }

    final parts = _currentPath
        .split('/')
        .where((part) => part.isNotEmpty)
        .toList();

    if (parts.isEmpty) {
      _openFolder('/');
      return;
    }

    parts.removeLast();

    final parentPath = parts.isEmpty
        ? '/'
        : '/${parts.join('/')}';

    _openFolder(parentPath);
  }

  bool _isImage(String name) {
    return RegExp(
      r'\.(avif|gif|jpe?g|png|webp)$',
      caseSensitive: false,
    ).hasMatch(name);
  }

  bool _isVideo(String name) {
    return RegExp(
      r'\.(m4v|mov|mp4|webm|ogv)$',
      caseSensitive: false,
    ).hasMatch(name);
  }

  String _formatSize(dynamic value) {
    final bytes = value is num ? value.toInt() : 0;

    if (bytes < 1024) {
      return '$bytes B';
    }

    if (bytes < 1024 * 1024) {
      return '${(bytes / 1024).toStringAsFixed(1)} KB';
    }

    if (bytes < 1024 * 1024 * 1024) {
      return '${(bytes / (1024 * 1024)).toStringAsFixed(1)} MB';
    }

    return '${(bytes / (1024 * 1024 * 1024)).toStringAsFixed(1)} GB';
  }

  IconData _fileIcon(String name) {
    final extension = name.contains('.')
        ? name.split('.').last.toLowerCase()
        : '';

    switch (extension) {
      case 'pdf':
        return Icons.picture_as_pdf_outlined;
      case 'doc':
      case 'docx':
        return Icons.description_outlined;
      case 'xls':
      case 'xlsx':
        return Icons.table_chart_outlined;
      case 'ppt':
      case 'pptx':
        return Icons.slideshow_outlined;
      case 'zip':
      case 'rar':
      case '7z':
        return Icons.archive_outlined;
      case 'txt':
      case 'md':
        return Icons.article_outlined;
      case 'mp3':
      case 'wav':
      case 'flac':
      case 'ogg':
        return Icons.audiotrack_outlined;
      default:
        return Icons.insert_drive_file_outlined;
    }
  }

  String _previewUrl(String path) {
    final serverUrl = _api?.baseUrl ?? '';

    return '$serverUrl/api/v1/preview?path=${Uri.encodeComponent(path)}';
  }

  void _openPreview(Map<String, dynamic> item) {
    final name = item['name']?.toString() ?? 'Archivo';
    final path = item['path']?.toString() ?? '';

    if (path.isEmpty) {
      return;
    }

    final url = _previewUrl(path);

    Navigator.of(context).push(
      MaterialPageRoute<void>(
        builder: (context) => _PreviewPage(
          name: name,
          url: url,
          isVideo: _isVideo(name),
        ),
      ),
    );
  }

  void _openItem(Map<String, dynamic> item) {
    final type = item['type']?.toString() ?? 'file';
    final path = item['path']?.toString() ?? '';
    final name = item['name']?.toString() ?? 'Archivo';

    if (path.isEmpty) {
      return;
    }

    if (type == 'directory') {
      _openFolder(path);
      return;
    }

    if (_isImage(name) || _isVideo(name)) {
      _openPreview(item);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        leading: IconButton(
          icon: const Icon(Icons.arrow_back),
          onPressed: _goBack,
        ),
        title: const Text('Mis archivos'),
        actions: [
          SegmentedButton<bool>(
            segments: const [
              ButtonSegment<bool>(
                value: false,
                icon: Icon(Icons.view_list),
                label: Text('Lista'),
              ),
              ButtonSegment<bool>(
                value: true,
                icon: Icon(Icons.grid_view),
                label: Text('Parrilla'),
              ),
            ],
            selected: {_gridView},
            onSelectionChanged: (selection) {
              setState(() {
                _gridView = selection.first;
              });
            },
          ),
          const SizedBox(width: 8),
          IconButton(
            icon: const Icon(Icons.refresh),
            onPressed: _loading ? null : _loadFiles,
          ),
          const SizedBox(width: 8),
        ],
      ),
      body: _buildBody(),
    );
  }

  Widget _buildBody() {
    if (_loading) {
      return const Center(
        child: CircularProgressIndicator(),
      );
    }

    if (_error != null) {
      return Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const Icon(
                Icons.error_outline,
                size: 48,
              ),
              const SizedBox(height: 16),
              Text(
                _error!,
                textAlign: TextAlign.center,
              ),
              const SizedBox(height: 16),
              FilledButton.icon(
                onPressed: _loadFiles,
                icon: const Icon(Icons.refresh),
                label: const Text('Reintentar'),
              ),
            ],
          ),
        ),
      );
    }

    if (_items.isEmpty) {
      return RefreshIndicator(
        onRefresh: _loadFiles,
        child: ListView(
          children: const [
            SizedBox(height: 180),
            Center(
              child: Text('Esta carpeta está vacía.'),
            ),
          ],
        ),
      );
    }

    if (_gridView) {
      return _buildGrid();
    }

    return _buildList();
  }

  Widget _buildList() {
    return RefreshIndicator(
      onRefresh: _loadFiles,
      child: ListView.separated(
        padding: const EdgeInsets.symmetric(vertical: 8),
        itemCount: _items.length,
        separatorBuilder: (context, index) {
          return const Divider(height: 1);
        },
        itemBuilder: (context, index) {
          final item = _items[index];

          final name = item['name']?.toString() ?? 'Sin nombre';
          final type = item['type']?.toString() ?? 'file';
          final path = item['path']?.toString() ?? '';
          final size = item['size'];

          final isDirectory = type == 'directory';
          final isImage = _isImage(name);
          final isVideo = _isVideo(name);

          return ListTile(
            leading: SizedBox(
              width: 48,
              height: 48,
              child: isImage
                  ? ClipRRect(
                      borderRadius: BorderRadius.circular(8),
                      child: Image.network(
                        _previewUrl(path),
                        fit: BoxFit.cover,
                        errorBuilder: (context, error, stackTrace) {
                          return const Icon(
                            Icons.broken_image_outlined,
                          );
                        },
                      ),
                    )
                  : Icon(
                      isDirectory
                          ? Icons.folder_outlined
                          : isVideo
                              ? Icons.video_file_outlined
                              : _fileIcon(name),
                    ),
            ),
            title: Text(
              name,
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
            subtitle: Text(
              isDirectory
                  ? 'Carpeta'
                  : '${_formatSize(size)} · Archivo',
            ),
            trailing: isDirectory
                ? const Icon(Icons.chevron_right)
                : (isImage || isVideo)
                    ? const Icon(Icons.visibility_outlined)
                    : null,
            onTap: () => _openItem(item),
          );
        },
      ),
    );
  }

  Widget _buildGrid() {
    return RefreshIndicator(
      onRefresh: _loadFiles,
      child: GridView.builder(
        padding: const EdgeInsets.all(10),
        gridDelegate: const SliverGridDelegateWithMaxCrossAxisExtent(
          maxCrossAxisExtent: 240,
          mainAxisSpacing: 10,
          crossAxisSpacing: 10,
          childAspectRatio: 1,
        ),
        itemCount: _items.length,
        itemBuilder: (context, index) {
          final item = _items[index];

          final name = item['name']?.toString() ?? 'Sin nombre';
          final type = item['type']?.toString() ?? 'file';
          final path = item['path']?.toString() ?? '';

          final isDirectory = type == 'directory';
          final isImage = _isImage(name);
          final isVideo = _isVideo(name);

          return Material(
            color: Theme.of(context).colorScheme.surfaceContainerHighest,
            borderRadius: BorderRadius.circular(18),
            clipBehavior: Clip.antiAlias,
            child: InkWell(
              onTap: () => _openItem(item),
              child: Stack(
                fit: StackFit.expand,
                children: [
                  if (isImage)
                    Image.network(
                      _previewUrl(path),
                      fit: BoxFit.cover,
                      errorBuilder: (context, error, stackTrace) {
                        return _buildGridFileIcon(
                          name,
                          isDirectory,
                        );
                      },
                    )
                  else if (isVideo)
                    _buildVideoThumbnail(
                      path,
                      name,
                    )
                  else
                    _buildGridFileIcon(
                      name,
                      isDirectory,
                    ),
                  if (!isImage && !isVideo && !isDirectory)
                    Positioned(
                      left: 10,
                      right: 10,
                      bottom: 10,
                      child: Text(
                        name,
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                        textAlign: TextAlign.center,
                      ),
                    ),
                  if (isDirectory)
                    Positioned(
                      left: 10,
                      right: 10,
                      bottom: 10,
                      child: Text(
                        name,
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                        textAlign: TextAlign.center,
                      ),
                    ),
                ],
              ),
            ),
          );
        },
      ),
    );
  }

  Widget _buildGridFileIcon(
    String name,
    bool isDirectory,
  ) {
    return Center(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(
            isDirectory
                ? Icons.folder_rounded
                : _fileIcon(name),
            size: 64,
          ),
          if (isDirectory) const SizedBox(height: 10),
        ],
      ),
    );
  }

  Widget _buildVideoThumbnail(
    String path,
    String name,
  ) {
    return Stack(
      fit: StackFit.expand,
      children: [
        Image.network(
          _previewUrl(path),
          fit: BoxFit.cover,
          errorBuilder: (context, error, stackTrace) {
            return const Center(
              child: Icon(
                Icons.video_file_outlined,
                size: 64,
              ),
            );
          },
        ),
        const Center(
          child: DecoratedBox(
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: Colors.black54,
            ),
            child: Padding(
              padding: EdgeInsets.all(14),
              child: Icon(
                Icons.play_arrow,
                color: Colors.white,
                size: 32,
              ),
            ),
          ),
        ),
      ],
    );
  }
}

class _PreviewPage extends StatelessWidget {
  const _PreviewPage({
    required this.name,
    required this.url,
    required this.isVideo,
  });

  final String name;
  final String url;
  final bool isVideo;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      appBar: AppBar(
        backgroundColor: Colors.black,
        foregroundColor: Colors.white,
        title: Text(
          name,
          maxLines: 1,
          overflow: TextOverflow.ellipsis,
        ),
      ),
      body: Center(
        child: isVideo
            ? _VideoPreview(url: url)
            : InteractiveViewer(
                minScale: 0.5,
                maxScale: 5,
                child: Image.network(
                  url,
                  fit: BoxFit.contain,
                  errorBuilder: (context, error, stackTrace) {
                    return const Center(
                      child: Text(
                        'No se pudo cargar la vista previa.',
                        style: TextStyle(color: Colors.white),
                      ),
                    );
                  },
                ),
              ),
      ),
    );
  }
}

class _VideoPreview extends StatefulWidget {
  const _VideoPreview({
    required this.url,
  });

  final String url;

  @override
  State<_VideoPreview> createState() => _VideoPreviewState();
}

class _VideoPreviewState extends State<_VideoPreview> {
  @override
  Widget build(BuildContext context) {
    return const Center(
      child: Text(
        'Vista previa de video',
        style: TextStyle(color: Colors.white),
      ),
    );
  }
}
